# syntax=docker/dockerfile:1

# Base: official Node image on Debian slim (trixie). Pinned to the multi-arch
# manifest-list digest of node:26-slim; podman selects the matching arch.
# Per-arch digests if you prefer a single-platform pin:
#   amd64: sha256:18f03e4b532a63baf09809fe8349c2171807f1818cb6c5230fb12aecd5beda65
#   arm64: sha256:3591f3d5d65d087d01271d05ee93b6ee693c05a27b7cf80b4de363a1a9c13954
FROM docker.io/library/node:26-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072 AS base

# uv, pinned to the 0.13.6 multi-arch image digest
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 \
    /uv /uvx /usr/local/bin/

# Docker runtime (dockerd + docker CLI + docker-init/docker-proxy +
# runc/ctr/containerd shims), copied wholesale from the digest-pinned official
# dind image. Binaries are static, so the alpine-based source works on Debian.
# dockerd 27.x embeds containerd, so the containerd binary itself is not
# needed (upstream excludes it from dind too). The dind helper script and the
# alpine-oriented entrypoint are removed again right below.
COPY --from=docker.io/library/docker:29.9.3-dind@sha256:08a98015fce594af7c382883bea080ea206de74402a95da9dc52b6428c8cd121 \
    /usr/local/bin/ /usr/local/bin/
COPY --from=docker.io/library/docker:29.9.3-dind@sha256:08a98015fce594af7c382883bea080ea206de74402a95da9dc52b6428c8cd121 \
    /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/

# Runtime dependencies for dockerd (mirrors the upstream dind image's dep
# list): iptables/ip6tables for bridge networking, pigz/xz-utils for layer
# compression, uidmap for userns-remap. ca-certificates provides the system
# trust store that dockerd (Go crypto/x509) reads for registry pulls. procps
# is needed by codex, whose pid-managed app server shells out to `ps` at
# startup. bubblewrap is codex's Linux sandboxing backend (codex falls back
# to its bundled copy, but the distro package is the supported path).
# openssh-client provides git-over-SSH inside the guest; socat provides the
# guest end of the SSH agent bridge (see plan-msb-ssh-agent-forwarding.md).
# This is the only apt layer (apt has no digest pinning); everything
# else is hash-referenced.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        git \
        iptables \
        jq \
        openssh-client \
        pigz \
        procps \
        socat \
        uidmap \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/bin/dind /usr/local/bin/dockerd-entrypoint.sh

# s6-overlay: init system and service supervisor (PID 1 via
# `msb run --init auto`, which recognizes /init). Pinned by version and
# sha256; both architecture tarballs are fetched and the matching one is
# installed (uname -m is x86_64 or aarch64). See plan-msb-s6.md.
ADD https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-noarch.tar.xz /tmp/s6/
ADD https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-x86_64.tar.xz /tmp/s6/
ADD https://github.com/just-containers/s6-overlay/releases/download/v3.2.3.2/s6-overlay-aarch64.tar.xz /tmp/s6/
RUN set -eu; \
    cd /tmp/s6; \
    printf '%s\n' \
        '5379750ed30a84bbd2e2dd74847ba6b5bd29cd0b2e3ea2ec58049b57eb2eda12  s6-overlay-noarch.tar.xz' \
        'e6befcc96a437a3831386ecfc51808c5d3e939dc5fe3c02ae9284599e8aa2408  s6-overlay-x86_64.tar.xz' \
        'b17f17a82e7a515c682a91edaf2ffdabb73f891981b6c1fd712115693a2f8b4c  s6-overlay-aarch64.tar.xz' \
        | sha256sum -c -; \
    arch="$(uname -m)"; \
    case "$arch" in x86_64|aarch64) ;; *) echo "unsupported architecture: $arch" >&2; exit 1 ;; esac; \
    tar -C / -Jxpf s6-overlay-noarch.tar.xz; \
    tar -C / -Jxpf "s6-overlay-${arch}.tar.xz"; \
    cd /; rm -rf /tmp/s6

# Python 3.14 interpreter, provisioned by uv. The tarball is fetched from
# astral-sh/python-build-standalone at build time; uv verifies it against the
# checksum in its embedded manifest (fixed by the pinned uv version above).
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON=3.14 \
    PATH=/opt/uv-python/bin:${PATH}

RUN uv python install 3.14 --default

# Pin the default interpreter for uv in this image
RUN uv python pin 3.14 --global

# Always talk to the local dockerd socket, even if a DOCKER_HOST leaks in
# from the session environment
ENV DOCKER_HOST=unix:///var/run/docker.sock

# Point TLS clients with their own CA lists at the system bundle, so CAs
# that msb adds (--trust-host-cas, TLS interception) are trusted:
# NODE_EXTRA_CA_CERTS for Node, REQUESTS_CA_BUNDLE for Python requests,
# SSL_CERT_FILE for OpenSSL-based clients, Python's ssl module, and uv.
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# Create the docker group so dockerd can chown the socket to it; silences
# the "group docker not found" warning on first boot.
RUN addgroup --system docker || true

# Services, supervised by s6-overlay (s6-rc), written inline with printf so
# the Dockerfile stays a single file. They start on every boot, including
# `msb start` (the old ENTRYPOINT script ran only on the first boot):
# - circus-ca-import (oneshot): imports the msb TLS interception CA from
#   /.msb/tls/ca.pem before dockerd starts (Go caches the system cert pool
#   per process). Host CAs (--trust-host-cas) are installed by msb itself.
# - circus-ssh-agent-bridge (longrun): when CIRCUS_SSH_AGENT_VSOCK_PORT is
#   set (msb-circus passes it with a matching --vsock route), socat relays
#   /run/ssh-agent.sock to the host SSH agent over vsock (CID 2). Idles
#   otherwise. Log: /tmp/ssh-agent-bridge.log.
# - circus-dockerd (longrun, after circus-ca-import): dockerd 29 needs a
#   real filesystem under /var/lib/docker (overlayfs on overlayfs fails),
#   i.e. a mount-owned disk or a flat root. Otherwise it logs why and
#   idles. CIRCUS_DOCKERD_SHUTDOWN_TIMEOUT (seconds, set by msb-circus)
#   bounds how long dockerd waits for containers at shutdown.
#   Log: /tmp/dockerd.log.
# Idle services run `sleep infinity` instead of exiting, because s6
# restarts a longrun that exits.
RUN set -eu; \
    d=/etc/s6-overlay/s6-rc.d; \
    b=/etc/s6-overlay/user-bundles.d/user/contents.d; \
    mkdir -p /etc/s6-overlay/scripts "$b" \
        "$d/circus-ca-import/dependencies.d" \
        "$d/circus-ssh-agent-bridge/dependencies.d" \
        "$d/circus-dockerd/dependencies.d"; \
    for s in circus-ca-import circus-ssh-agent-bridge circus-dockerd; do \
        : > "$b/$s"; \
        : > "$d/$s/dependencies.d/base"; \
    done; \
    : > "$d/circus-dockerd/dependencies.d/circus-ca-import"; \
    echo oneshot > "$d/circus-ca-import/type"; \
    echo /etc/s6-overlay/scripts/circus-ca-import > "$d/circus-ca-import/up"; \
    echo longrun > "$d/circus-ssh-agent-bridge/type"; \
    echo longrun > "$d/circus-dockerd/type"; \
    printf '%s\n' \
        '#!/bin/sh' \
        'if [ -r /.msb/tls/ca.pem ] && command -v update-ca-certificates >/dev/null 2>&1; then' \
        '    if ! cmp -s /.msb/tls/ca.pem /usr/local/share/ca-certificates/msb-intercept.crt; then' \
        '        mkdir -p /usr/local/share/ca-certificates' \
        '        cp /.msb/tls/ca.pem /usr/local/share/ca-certificates/msb-intercept.crt' \
        '        update-ca-certificates || echo "circus-ca-import: update-ca-certificates failed" >&2' \
        '    fi' \
        'fi' \
        'exit 0' \
        > /etc/s6-overlay/scripts/circus-ca-import; \
    printf '%s\n' \
        '#!/command/with-contenv sh' \
        'exec >>/tmp/ssh-agent-bridge.log 2>&1' \
        'echo "--- circus-ssh-agent-bridge start $(date -Is)"' \
        'if [ -z "${CIRCUS_SSH_AGENT_VSOCK_PORT:-}" ]; then' \
        '    echo "CIRCUS_SSH_AGENT_VSOCK_PORT is not set; SSH agent forwarding is off."' \
        '    exec sleep infinity' \
        'fi' \
        'rm -f /run/ssh-agent.sock' \
        'exec socat UNIX-LISTEN:/run/ssh-agent.sock,fork,mode=600 "VSOCK-CONNECT:2:${CIRCUS_SSH_AGENT_VSOCK_PORT}"' \
        > "$d/circus-ssh-agent-bridge/run"; \
    printf '%s\n' \
        '#!/command/with-contenv sh' \
        'exec >>/tmp/dockerd.log 2>&1' \
        'echo "--- circus-dockerd start $(date -Is)"' \
        'usable=0' \
        'if mountpoint -q /var/lib/docker 2>/dev/null; then' \
        '    usable=1' \
        'else' \
        '    mkdir -p /var/lib/docker' \
        '    if [ "$(stat -f -c %T /var/lib/docker)" != "overlayfs" ]; then' \
        '        usable=1' \
        '    fi' \
        'fi' \
        'if [ "$usable" -ne 1 ]; then' \
        '    echo "docker is not usable in this sandbox: the docker data root is on overlayfs."' \
        '    echo "Enable docker with docker_disk = \"10G\" (or root_disk = \"flat:32G\") under [msb.sandbox] in"' \
        '    echo ".agent-circus/config.toml, then recreate the sandbox (msb-circus rm -f && msb-circus up)."' \
        '    exec sleep infinity' \
        'fi' \
        'exec dockerd --shutdown-timeout "${CIRCUS_DOCKERD_SHUTDOWN_TIMEOUT:-20}"' \
        > "$d/circus-dockerd/run"; \
    chmod 755 /etc/s6-overlay/scripts/circus-ca-import \
        "$d/circus-ssh-agent-bridge/run" "$d/circus-dockerd/run"

# Never fail the boot because a service is slow to come up.
ENV S6_CMD_WAIT_FOR_SERVICES_MAXTIME=0

# s6-overlay's /init becomes PID 1 via `msb run --init auto`.
ENTRYPOINT ["/init"]

# --- Agents target: build with --target agents -------------------------------

FROM base AS agents

# NODE_OPTIONS matches agent-circus's claude-code service (large JS heap for
# long Claude Code sessions).
ENV NODE_OPTIONS=--max-old-space-size=4096

# Exact versions; npm enforces registry integrity hashes on install.
# claude-code and @opencode/cli run install scripts and are allow-listed
# explicitly (npm blocks lifecycle scripts otherwise). Versions are kept in
# sync with the agent-circus template via agent-circus-update-templates.
RUN npm install --global \
        --allow-scripts=@opencode/cli,@anthropic-ai/claude-code \
        @opencode/cli@2.2.7 \
        @anthropic-ai/claude-code@2.1.322 \
        @agentclientprotocol/claude-agent-acp@0.104.1 \
        @openai/codex@0.167.0 \
        @agentclientprotocol/codex-acp@2.6.0 \
        @earendil-works/pi-coding-agent@1.5.2 pi-acp@0.0.34

# No main program: s6-overlay only supervises the services. With a CMD,
# s6-overlay shuts the sandbox down when that program exits (a detached
# bash exits at once). The node base image sets CMD ["node"]; clear it.
CMD []
