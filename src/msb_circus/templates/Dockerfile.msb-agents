# syntax=docker/dockerfile:1

# Base: official Node image on Debian slim (trixie). Pinned to the multi-arch
# manifest-list digest of node:26-slim; podman selects the matching arch.
# Per-arch digests if you prefer a single-platform pin:
#   amd64: sha256:18f03e4b532a63baf09809fe8349c2171807f1818cb6c5230fb12aecd5beda65
#   arm64: sha256:3591f3d5d65d087d01271d05ee93b6ee693c05a27b7cf80b4de363a1a9c13954
FROM docker.io/library/node:26-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072 AS base

# uv, pinned to the 0.13.6 multi-arch image digest
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 \
    /uv /uvx /usr/local/bin/

# Docker runtime (dockerd + docker CLI + docker-init/docker-proxy +
# runc/ctr/containerd shims), copied wholesale from the digest-pinned official
# dind image. Binaries are static, so the alpine-based source works on Debian.
# dockerd 27.x embeds containerd, so the containerd binary itself is not
# needed (upstream excludes it from dind too). The dind helper script and the
# alpine-oriented entrypoint are removed again right below.
COPY --from=docker.io/library/docker:29.9.3-dind@sha256:08a98015fce594af7c382883bea080ea206de74402a95da9dc52b6428c8cd121 \
    /usr/local/bin/ /usr/local/bin/
COPY --from=docker.io/library/docker:29.9.3-dind@sha256:08a98015fce594af7c382883bea080ea206de74402a95da9dc52b6428c8cd121 \
    /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/

# Runtime dependencies for dockerd (mirrors the upstream dind image's dep
# list): iptables/ip6tables for bridge networking, pigz/xz-utils for layer
# compression, uidmap for userns-remap. ca-certificates provides the system
# trust store that dockerd (Go crypto/x509) reads for registry pulls. procps
# is needed by codex, whose pid-managed app server shells out to `ps` at
# startup. bubblewrap is codex's Linux sandboxing backend (codex falls back
# to its bundled copy, but the distro package is the supported path).
# openssh-client provides git-over-SSH inside the guest; socat provides the
# guest end of the SSH agent bridge (see plan-msb-ssh-agent-forwarding.md).
# This is the only apt layer (apt has no digest pinning); everything
# else is hash-referenced.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bubblewrap \
        ca-certificates \
        git \
        iptables \
        jq \
        openssh-client \
        pigz \
        procps \
        socat \
        uidmap \
        xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/local/bin/dind /usr/local/bin/dockerd-entrypoint.sh

# Python 3.14 interpreter, provisioned by uv. The tarball is fetched from
# astral-sh/python-build-standalone at build time; uv verifies it against the
# checksum in its embedded manifest (fixed by the pinned uv version above).
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON=3.14 \
    PATH=/opt/uv-python/bin:${PATH}

RUN uv python install 3.14 --default

# Pin the default interpreter for uv in this image
RUN uv python pin 3.14 --global

# Always talk to the local dockerd socket, even if a DOCKER_HOST leaks in
# from the session environment
ENV DOCKER_HOST=unix:///var/run/docker.sock

# Create the docker group so dockerd can chown the socket to it; silences
# the "group docker not found" warning on first boot.
RUN addgroup --system docker || true

# Entrypoint: start dockerd in the background on boot (unless it is already
# reachable), wait until it is ready (its log lands in /tmp/dockerd.log), and
# only then hand over to the image command (default: bash). Written inline
# with printf so the Dockerfile stays a single file. Before starting dockerd,
# the sandbox TLS interception CA is imported when TLS interception is enabled
# (it appears at /.msb/tls/ca.pem in the guest); this must happen before
# dockerd starts because Go caches the system cert pool per process.
#
# dockerd 29 uses the containerd image store with the overlayfs snapshotter,
# which needs a real filesystem under /var/lib/docker. The kernel refuses an
# overlayfs as an overlayfs upperdir (EINVAL on mount), so a docker data root
# on the sandbox's overlayfs root cannot back it. The sandbox boot therefore
# checks the data root first: when it cannot back dockerd, dockerd is not
# started and a clear explanation is printed, so docker commands fail fast
# instead of failing late with a cryptic mount error. The sandbox boots
# either way, so agents that never touch docker keep working. Docker is
# enabled by msb-circus via a mount-owned disk (--mount-owned
# /var/lib/docker:kind=disk) or a flat root (--root-disk flat:...); see
# plan-msb-disks.md.
#
# SSH agent bridge: when CIRCUS_SSH_AGENT_VSOCK_PORT is set (msb-circus
# passes it together with a matching --vsock route at sandbox creation), a
# background socat relays a guest Unix socket to the host SSH agent over
# virtio-vsock (CID 2). Guest processes then talk to the host agent via
# SSH_AUTH_SOCK=/run/ssh-agent.sock; see plan-msb-ssh-agent-forwarding.md.
# The bridge starts first so that it neither waits for dockerd (up to 60
# seconds) nor is skipped when the dockerd wait ends the script early.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -e' \
        'if [ -n "${CIRCUS_SSH_AGENT_VSOCK_PORT:-}" ] && command -v socat >/dev/null 2>&1; then' \
        '    rm -f /run/ssh-agent.sock' \
        '    socat UNIX-LISTEN:/run/ssh-agent.sock,fork,mode=600 "VSOCK-CONNECT:2:${CIRCUS_SSH_AGENT_VSOCK_PORT}" >/tmp/ssh-agent-bridge.log 2>&1 &' \
        'fi' \
        'if [ -r /.msb/tls/ca.pem ] && command -v update-ca-certificates >/dev/null 2>&1; then' \
        '    if ! cmp -s /.msb/tls/ca.pem /usr/local/share/ca-certificates/msb-intercept.crt; then' \
        '        mkdir -p /usr/local/share/ca-certificates' \
        '        cp /.msb/tls/ca.pem /usr/local/share/ca-certificates/msb-intercept.crt' \
        '        update-ca-certificates' \
        '    fi' \
        'fi' \
        'docker_usable=0' \
        'if mountpoint -q /var/lib/docker 2>/dev/null; then' \
        '    docker_usable=1' \
        'else' \
        '    mkdir -p /var/lib/docker' \
        '    if [ "$(stat -f -c %T /var/lib/docker)" != "overlayfs" ]; then' \
        '        docker_usable=1' \
        '    fi' \
        'fi' \
        'if [ "$docker_usable" -eq 1 ]; then' \
        '    if ! docker info >/dev/null 2>&1; then' \
        '        dockerd >/tmp/dockerd.log 2>&1 &' \
        '        if ! timeout 60 sh -c "until docker info >/dev/null 2>&1; do sleep 1; done"; then' \
        '            echo "dockerd failed to become ready; /tmp/dockerd.log follows:" >&2' \
        '            cat /tmp/dockerd.log >&2' \
        '            exit 1' \
        '        fi' \
        '    fi' \
        'else' \
        '    echo "docker is not usable in this sandbox: the docker data root is on overlayfs." >&2' \
        '    echo "Enable docker with docker_disk = \"10G\" (or root_disk = \"flat:32G\") under [msb.sandbox] in" >&2' \
        '    echo ".agent-circus/config.toml, then recreate the sandbox (msb-circus rm && msb-circus up)." >&2' \
        'fi' \
        'exec "$@"' \
        > /usr/local/bin/docker-entrypoint.sh \
    && chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# --- Agents target: build with --target agents -------------------------------

FROM base AS agents

# NODE_OPTIONS matches agent-circus's claude-code service (large JS heap for
# long Claude Code sessions).
ENV NODE_OPTIONS=--max-old-space-size=4096

# Exact versions; npm enforces registry integrity hashes on install.
# claude-code and @opencode/cli run install scripts and are allow-listed
# explicitly (npm blocks lifecycle scripts otherwise). Versions are kept in
# sync with the agent-circus template via agent-circus-update-templates.
RUN npm install --global \
        --allow-scripts=@opencode/cli,@anthropic-ai/claude-code \
        @opencode/cli@2.2.5 \
        @anthropic-ai/claude-code@2.1.319 \
        @agentclientprotocol/claude-agent-acp@0.101.0 \
        @openai/codex@0.167.0 \
        @agentclientprotocol/codex-acp@2.5.0 \
        @earendil-works/pi-coding-agent@1.5.0 pi-acp@0.0.34

CMD ["bash"]
